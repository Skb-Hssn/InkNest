{
  "name": "inknest",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop Markdown note-taking app.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --noSandbox -- --disable-gpu --disable-gpu-compositing --disable-accelerated-video-decode --disable-accelerated-video-encode --disable-features=Vulkan,DefaultANGLEVulkan,VulkanFromANGLE,VaapiVideoDecoder,VaapiVideoEncoder --ozone-platform=x11",
    "check": "node scripts/check-scaffold.mjs && npm test && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "npm run build && playwright test",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "package": "npm run build",
    "release-check": "node scripts/release-check.mjs",
    "package:deb": "npm run build && electron-builder --linux deb --x64 --publish never"
  },
  "keywords": [
    "markdown",
    "notes",
    "electron",
    "local-first"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@milkdown/kit": "^7.22.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "homepage": "https://github.com/Skb-Hssn/InkNest",
  "desktopName": "io.github.skb-hssn.inknest"
}
